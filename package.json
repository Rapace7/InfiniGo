{
  "name": "rapacego",
  "productName": "RapaceGo",
  "version": "0.1.25",
  "description": "玄清围弈 —— 跟 AI 下棋、看客观数据、听本地模型讲棋",
  "author": "Rapace7",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.rapace7.rapacego",
    "productName": "RapaceGo",
    "copyright": "Copyright © 2026 Rapace7",
    "directories": { "output": "dist" },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "engine.cfg",
      "assets/app.ico",
      "assets/audio/**/*",
      "assets/icon-256.png",
      "assets/icon-512.png",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "zip", "arch": ["x64"] }
      ],
      "icon": "assets/app.ico",
      "artifactName": "RapaceGo.${ext}"
    },
    "mac": {
      "target": [
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "assets/icon-512.png",
      "category": "public.app-category.board-games",
      "artifactName": "RapaceGo-mac-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraFiles": []
    },
    "extraFiles": [
      { "from": "下载讲解模型.bat", "to": "." }
    ]
  }
}
