# ============================================================
#  InfiniGo（玄清围弈）· 不进入仓库的东西
# ============================================================

# ---------- 依赖：别人自己 npm install ----------
node_modules/

# ---------- 本机运行时产物 ----------
# settings.json 里存的是**你本机的引擎绝对路径**（设置面板保存时生成）。
# 发出去等于把自己的盘符结构公开，而且别人拿到也没用（路径不一样）。
settings.json

# 引擎日志（每次跑 KataGo 都会写）
engine-logs/

# 棋谱库（你的真实对局，涉及隐私）
records/

# 开发期的临时产物：测试截图 / 中间日志 / 探针脚本
_trash/

# ---------- 系统生成的垃圾 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---------- 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
